[Unit]
Description=Verify Terminus Lean ternary QAT artifacts in S3 and Blob, then deallocate H100
Wants=network-online.target
After=network-online.target terminus-lean-qat-2b.service
RequiresMountsFor=/srv/terminus-10b
StartLimitIntervalSec=0

[Service]
Type=simple
User=terminus
Group=terminus
WorkingDirectory=/opt/terminus
ExecStart=/opt/terminus-runtime/bin/python /opt/terminus/experiments/terminus_lean_150m_qat_2b/finalize_blob_and_deallocate.py --run-root /srv/terminus-10b/runs/lean_ternary_qat_2b_20261002 --s3-run-uri s3://YOUR_RUN_BUCKET/terminus_lean_150m_qat_2b_run_20261002 --blob-url https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net/YOUR_ARCHIVE_CONTAINER/terminus_lean_150m_qat_2b_run_20261002/ --vm-resource-id /subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Compute/virtualMachines/YOUR_VM_NAME --train-service terminus-lean-qat-2b.service --ops-log /srv/terminus-10b/ops/qat/finalizer.log --poll-seconds 10
Restart=on-failure
RestartSec=300
StandardOutput=append:/srv/terminus-10b/ops/qat/finalizer.log
StandardError=append:/srv/terminus-10b/ops/qat/finalizer.log

[Install]
WantedBy=multi-user.target
