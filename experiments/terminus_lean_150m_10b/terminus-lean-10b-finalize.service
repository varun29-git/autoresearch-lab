[Unit]
Description=Verify Terminus Lean 10B artifacts in Azure Blob, then deallocate H100
Wants=network-online.target
After=network-online.target terminus-lean-10b.service
RequiresMountsFor=/srv/terminus-10b
StartLimitIntervalSec=0

[Service]
Type=simple
User=terminus
Group=terminus
WorkingDirectory=/opt/terminus
ExecStart=/usr/bin/python3 /opt/terminus/experiments/terminus_lean_150m_10b/finalize_blob_and_deallocate.py --run-root /srv/terminus-10b/runs/lean_dense_10b_20261001 --blob-url https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net/YOUR_ARCHIVE_CONTAINER/terminus_lean_150m_10b_run_20261001/ --vm-resource-id /subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/YOUR_RESOURCE_GROUP/providers/Microsoft.Compute/virtualMachines/YOUR_VM_NAME --train-service terminus-lean-10b.service --ops-log /srv/terminus-10b/ops/finalizer.log
Restart=on-failure
RestartSec=300
StandardOutput=append:/srv/terminus-10b/ops/finalizer.log
StandardError=append:/srv/terminus-10b/ops/finalizer.log

[Install]
WantedBy=multi-user.target
