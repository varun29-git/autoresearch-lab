{
  "resource_group": "YOUR_RESOURCE_GROUP",
  "vm_name": "YOUR_VM_NAME",
  "ssh_user": "YOUR_SSH_USER",
  "remote_repo": "/remote/path/outside/git/terminus-autoresearch",
  "remote_python": "/remote/path/to/runtime/bin/python",
  "remote_env": {
    "PYTHONPATH": "/remote/path/to/runtime/fa3-site",
    "CUDA_HOME": "/usr/local/cuda-13.2",
    "DG_JIT_NVCC_COMPILER": "/usr/local/cuda-13.2/bin/nvcc"
  },
  "remote_campaign": "/srv/YOUR_PERSISTENT_DISK/architecture/campaign.json",
  "remote_data_root": "/srv/YOUR_PERSISTENT_DISK/architecture/data",
  "remote_results_root": "/srv/YOUR_PERSISTENT_DISK/architecture/results",
  "persistent_mount": "/srv/YOUR_PERSISTENT_DISK",
  "verification_parent": "/srv/YOUR_PERSISTENT_DISK/architecture/verification_scratch",
  "blob_account": "YOUR_STORAGE_ACCOUNT",
  "blob_container": "YOUR_ARCHIVE_CONTAINER",
  "blob_prefix": "architecture",
  "local_control_root": "/absolute/path/outside/git/terminus-architecture-control",
  "max_vm_hours": 12.0
}
